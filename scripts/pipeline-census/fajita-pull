#!/usr/bin/env python3
"""Pull fajita's pipeline captures (NativeMetal NGPU_CAPTURE) over the USB debug hub and build the
census manifest from them.

    scripts/pipeline-census/fajita-pull [--hub PATH] [--cache DIR] [--out DIR]

It pulls the frontend's journal (CACHE/pipelines.log), reads its `X capture DIR` lines (one per
process that captured), pulls each DIR/capture.jsonl and every library it names, writes them
under OUT/<process>/ (default .cache/fajita-census/capture-<time>/), and runs capture_manifest.py
into OUT/manifest.json. Then:

    scripts/pipeline-census/a630-host --manifest OUT/manifest.json --out OUT/census

With a frame capture (NGPU_CAPTURE_FRAMES) it also pulls frames.jsonl and its blobs and builds
OUT/<process>/frames.json for command-replay (frames_manifest.py).

The phone side: `NGPU_CAPTURE=1` (and `NGPU_CAPTURE_FRAMES=N`, `NGPU_CAPTURE_SKIP=K`) in /private/var/ngpu/gpu-env, then the render server restarted
(`ngpu-metal killall backboardd`) so its device opens with the variable set. Everything pulled is
the render server's (Apple's shaders): it stays under the gitignored .cache/."""
import argparse
import functools
import hashlib
import shutil
import json
import os
import re
import subprocess
import sys
import time

here = os.path.dirname(os.path.abspath(__file__))
root = os.path.dirname(os.path.dirname(here))
ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
ap.add_argument('--hub', default='/home/john/src/UniXNU-fajita-ios16/scripts/fajita-usbdbg-hub.py')
ap.add_argument('--cache', default='/private/var/mobile/Library/Caches/com.apple.backboardd/m2v',
                help="the runtime's cache directory on the phone (the render server's)")
ap.add_argument('--wait', type=float, default=600,
                help='seconds to wait for each capture to end (its capture.done marker)')
ap.add_argument('--timeout', type=float, default=900, help='seconds a single pull may take')
ap.add_argument('--out', default=os.path.join(root, '.cache/fajita-census/capture-' + time.strftime('%Y%m%d-%H%M%S')))
ap.add_argument('--have', default=os.path.join(root, '.cache/fajita-census'),
                help='a directory of metallibs already on the host: a library whose digest matches one is copied, not pulled')
args = ap.parse_args()
print = functools.partial(print, flush=True)
have = {}
for name in os.listdir(args.have) if os.path.isdir(args.have) else []:
    if name.endswith('.metallib'):
        path = os.path.join(args.have, name)
        have[hashlib.sha256(open(path, 'rb').read()).hexdigest()[:16]] = path
os.makedirs(args.out, exist_ok=True)


def pull(remote, local, tries=3):
    """One file; a file still being written (size/crc mismatch) is pulled again."""
    for _ in range(tries - 1):
        if pull_once(remote, local, quiet=True):
            return True
        time.sleep(5)
    return pull_once(remote, local)


def pull_once(remote, local, quiet=False):
    os.makedirs(os.path.dirname(local), exist_ok=True)
    began = time.time()
    print('%s pulling %s' % (time.strftime('%H:%M:%S'), remote))
    r = subprocess.run([sys.executable, args.hub, 'call', '--timeout', str(args.timeout), 'pull', remote, local],
                       capture_output=True, text=True)
    ok = r.returncode == 0 and os.path.exists(local) and 'pulled' in (r.stdout + r.stderr)
    if ok or not quiet:
        print(('pulled ' if ok else 'FAILED ') + remote + (' (%d bytes, %.0f s)' % (os.path.getsize(local), time.time() - began) if ok else
              ': ' + (r.stdout + r.stderr).strip()[-200:]))
    return ok


journal = os.path.join(args.out, 'pipelines.log')
if not pull(args.cache + '/pipelines.log', journal):
    sys.exit('no journal: is the render server running with the plugin, and the hub up?')
dirs = []
for line in open(journal, errors='replace'):
    m = re.match(r'X capture (\S+)', line)
    if m and m.group(1) not in dirs:
        dirs.append(m.group(1))
if not dirs:
    sys.exit('the journal names no capture: set NGPU_CAPTURE=1 in /private/var/ngpu/gpu-env and restart backboardd')
def ended(d, leaf):
    """Waits for the capture's capture.done marker (the hook writes no record after it)."""
    limit = time.time() + args.wait
    while True:
        r = subprocess.run([sys.executable, args.hub, 'call', '--timeout', '60', 'pull', d + '/capture.done',
                            os.path.join(leaf, 'capture.done')], capture_output=True, text=True)
        if r.returncode == 0 and 'pulled' in r.stdout + r.stderr:
            print('ended: %s: %s' % (d, open(os.path.join(leaf, 'capture.done')).read().strip()))
            return True
        if time.time() > limit:
            print('NOT ENDED after %d s: %s' % (args.wait, d))
            return False
        time.sleep(15)


local_dirs = []
for d in dirs:
    leaf = os.path.join(args.out, os.path.basename(d))
    os.makedirs(leaf, exist_ok=True)
    if not ended(d, leaf):
        continue   # a process that died before its capture ended (its files may be cut short)
    if not pull(d + '/capture.jsonl', os.path.join(leaf, 'capture.jsonl')):
        continue
    local_dirs.append(leaf)
    for line in open(os.path.join(leaf, 'capture.jsonl'), errors='replace'):
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        if 'file' in r and 'library' in r:
            if r['library'] in have:
                shutil.copyfile(have[r['library']], os.path.join(leaf, r['file']))
                print('have %s (%s)' % (r['file'], os.path.basename(have[r['library']])))
            else:
                print('library %s: %d bytes' % (r['file'], r.get('bytes', 0)))
                pull(d + '/' + r['file'], os.path.join(leaf, r['file']))
    # The frame capture (NGPU_CAPTURE_FRAMES): its records and every blob they name.
    if pull(d + '/frames.jsonl', os.path.join(leaf, 'frames.jsonl')):
        blobs = set()
        for line in open(os.path.join(leaf, 'frames.jsonl'), errors='replace'):
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            if r.get('file'):
                blobs.add(r['file'])
            blobs.update(u['file'] for u in r.get('uploads', []) if u.get('file'))
        for b in sorted(blobs):
            if not os.path.exists(os.path.join(leaf, b)):
                pull(d + '/' + b, os.path.join(leaf, b))
        subprocess.run([sys.executable, '-I', os.path.join(here, 'frames_manifest.py'), leaf, '--out',
                        os.path.join(leaf, 'frames.json')], check=False)
if not local_dirs:
    sys.exit('no capture pulled')
subprocess.run([sys.executable, '-I', os.path.join(here, 'capture_manifest.py'), *local_dirs, '--out',
                os.path.join(args.out, 'manifest.json')], check=True)
print('next: %s/a630-host --manifest %s/manifest.json --out %s/census' % (here, args.out, args.out))
